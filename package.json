{
  "name": "daybreak-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:sim": "node scripts/smoke-sim.mjs",
    "build": "npm run wasm && npm run typecheck && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "6.4.1"
  }
}
